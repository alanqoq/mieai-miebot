{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "api": {
      "type": "object",
      "properties": {
        "baseUrl": { "type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^https?://[^/\\s]+/?$" },
        "apiKey": { "type": "string", "maxLength": 8192 },
        "protocol": { "type": "string", "enum": ["openai-old", "openai-new"] },
        "primaryModel": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^\\S+$" },
        "requestTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "fallbackModel": { "type": "string", "maxLength": 255 },
        "fallbackDurationMinutes": { "type": "integer", "minimum": 1, "maximum": 525600 }
      },
      "required": ["baseUrl", "apiKey", "protocol", "primaryModel", "requestTimeoutSeconds", "fallbackModel", "fallbackDurationMinutes"],
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "description": "插件指令别名。所有值都不包含开头的 /，留空表示该指令没有别名；非空别名最多 64 个 Unicode 字符、不能含空白/斜杠/控制字符，并且忽略大小写后必须唯一。",
      "properties": {
        "mainAlias": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:$|[^/\\s\\u0000-\\u001F\\u007F-\\u009F]+)$",
          "description": "/mieai 主指令的别名。用于显示帮助，也可替代 /mieai 前缀；例如填写 ai 后可使用 /ai、/ai help、/ai prob 50。"
        },
        "helpAlias": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:$|[^/\\s\\u0000-\\u001F\\u007F-\\u009F]+)$",
          "description": "/mieai help 的独立顶级别名，不带参数，用于显示完整帮助；例如填写 查询mieai指令 后使用 /查询mieai指令。"
        },
        "probAlias": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:$|[^/\\s\\u0000-\\u001F\\u007F-\\u009F]+)$",
          "description": "/mieai prob <1-100> 的独立顶级别名，用于设置当前群聊天概率；调用别名时仍须追加 1-100。"
        },
        "promptAlias": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:$|[^/\\s\\u0000-\\u001F\\u007F-\\u009F]+)$",
          "description": "/mieai prompt <提示词> 的独立顶级别名，用于设置当前群系统提示词；调用别名时仍须追加提示词。"
        },
        "keywordAlias": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:$|[^/\\s\\u0000-\\u001F\\u007F-\\u009F]+)$",
          "description": "/mieai keyword <关键词> 的独立顶级别名，用于设置当前群触发关键词；调用别名时仍须追加关键词。"
        },
        "chatAlias": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:$|[^/\\s\\u0000-\\u001F\\u007F-\\u009F]+)$",
          "description": "/mieai chat 的独立顶级别名，不带参数，用于切换当前群 AI 聊天的启用或禁用状态。"
        }
      },
      "required": ["mainAlias", "helpAlias", "probAlias", "promptAlias", "keywordAlias", "chatAlias"],
      "additionalProperties": false
    },
    "chat": {
      "type": "object",
      "properties": {
        "defaultProbability": { "type": "integer", "minimum": 0, "maximum": 100 },
        "groupProbabilities": { "type": "object", "additionalProperties": true },
        "defaultSystemPrompt": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "groupSystemPrompts": { "type": "object", "additionalProperties": true },
        "promptMaxLength": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "promptTooLongReply": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "defaultKeyword": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "groupKeywords": { "type": "object", "additionalProperties": true },
        "keywordMaxLength": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "keywordTooLongReply": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "disabledGroups": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^\\S+$" },
          "maxItems": 100000
        },
        "imageUnderstandingEnabled": { "type": "boolean" },
        "maxContextMessages": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "required": ["defaultProbability", "groupProbabilities", "defaultSystemPrompt", "groupSystemPrompts", "promptMaxLength", "promptTooLongReply", "defaultKeyword", "groupKeywords", "keywordMaxLength", "keywordTooLongReply", "disabledGroups", "imageUnderstandingEnabled", "maxContextMessages"],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "maxBase64ImageBytes": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "maxMessagesTotal": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "defaultMaxMessagesPerGroup": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "groupMaxMessages": { "type": "object", "additionalProperties": true },
        "maxMessageAgeDays": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "cleanupDeleteBatchSize": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "cleanupTime": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
      },
      "required": ["maxBase64ImageBytes", "maxMessagesTotal", "defaultMaxMessagesPerGroup", "groupMaxMessages", "maxMessageAgeDays", "cleanupDeleteBatchSize", "cleanupTime"],
      "additionalProperties": false
    },
    "queue": {
      "type": "object",
      "properties": {
        "maxPendingPerGroup": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      },
      "required": ["maxPendingPerGroup"],
      "additionalProperties": false
    }
  },
  "required": ["api", "chat", "storage", "queue"],
  "additionalProperties": false
}
